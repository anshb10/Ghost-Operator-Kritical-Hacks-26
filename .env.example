# TinyFish Web Agent API key (https://agent.tinyfish.ai). Without it the app replays recorded runs.
TINYFISH_API_KEY=
# Optional: auto | live | replay
GHOST_MODE=auto
TINYFISH_CONCURRENCY=2
TINYFISH_BROWSER_PROFILE=stealth
# Replay speed multiplier (20 = 20x faster than the real recorded run)
REPLAY_SPEED=20
# Claude for planning + recommendation memo. Without credentials, rule-based fallbacks are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
